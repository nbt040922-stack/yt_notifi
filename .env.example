TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public HTTPS tunnel origin only, without a trailing slash.
PUBLIC_CALLBACK_URL=
WEBHOOK_PATH=/youtube/websub

HOST=127.0.0.1
PORT=8787

# Optional: full path to cloudflared.exe. PATH and tools/cloudflared.exe are also checked.
CLOUDFLARED_PATH=

# Optional: full path to yt-dlp. tools/yt-dlp.exe and PATH are also checked.
YTDLP_PATH=
POLL_INTERVAL_SECONDS=10
POLL_MAX_CONCURRENCY=3
